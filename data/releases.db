PRAGMA foreign_keys = ON;
DROP TABLE IF EXISTS release_decisions;
DROP TABLE IF EXISTS previous_deployments;
DROP TABLE IF EXISTS open_issues;
DROP TABLE IF EXISTS service_health_checks;
DROP TABLE IF EXISTS test_results;
DROP TABLE IF EXISTS releases;
CREATE TABLE releases (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    service TEXT NOT NULL,
    version TEXT NOT NULL,
    environment TEXT NOT NULL CHECK (
        environment IN ('development', 'staging', 'production')
    ),
    requested_by TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending' CHECK (
        status IN ('pending', 'approved', 'review', 'blocked', 'deployed')
    ),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (service, version, environment)
);
CREATE TABLE test_results (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    passed INTEGER NOT NULL DEFAULT 0 CHECK (passed >= 0),
    failed INTEGER NOT NULL DEFAULT 0 CHECK (failed >= 0),
    status TEXT NOT NULL CHECK (status IN ('passed', 'failed')),
    checked_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE CASCADE
);
CREATE TABLE service_health_checks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    status TEXT NOT NULL CHECK (
        status IN ('healthy', 'degraded', 'unhealthy')
    ),
    response_time_ms INTEGER CHECK (response_time_ms >= 0),
    checked_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE CASCADE
);
CREATE TABLE open_issues (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    external_id TEXT NOT NULL,
    title TEXT NOT NULL,
    severity TEXT NOT NULL CHECK (
        severity IN ('low', 'medium', 'high', 'critical')
    ),
    status TEXT NOT NULL DEFAULT 'open' CHECK (
        status IN ('open', 'in_progress', 'resolved')
    ),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE CASCADE,
    UNIQUE (release_id, external_id)
);
CREATE TABLE previous_deployments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    service TEXT NOT NULL,
    version TEXT NOT NULL,
    environment TEXT NOT NULL CHECK (
        environment IN ('development', 'staging', 'production')
    ),
    status TEXT NOT NULL CHECK (
        status IN ('success', 'failed', 'rolled_back')
    ),
    deployed_at TEXT NOT NULL,
    deployed_by TEXT NOT NULL
);
CREATE TABLE release_decisions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    risk_level TEXT NOT NULL CHECK (risk_level IN ('low', 'medium', 'high')),
    decision TEXT NOT NULL CHECK (decision IN ('DEPLOY', 'REVIEW', 'BLOCK')),
    requires_human_review INTEGER NOT NULL CHECK (
        requires_human_review IN (0, 1)
    ),
    reasons TEXT NOT NULL DEFAULT '[]',
    decided_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE CASCADE
);
CREATE INDEX idx_releases_service_environment
ON releases(service, environment);
CREATE INDEX idx_previous_deployments_lookup
ON previous_deployments(service, environment, deployed_at DESC);
CREATE INDEX idx_open_issues_release_severity
ON open_issues(release_id, severity, status);
